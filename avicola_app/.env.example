# ==============================================================================
# Gemelo Digital Avícola (AV-1 / AV-2) — Variables de Entorno
# Copia este archivo como .env (en raíz del repo o dentro de avicola_app/.env)
# o configúralo desde el botón "⚙️ Credenciales" dentro de la app.
# NUNCA subas .env a Git ni pegues claves en chats.
# ==============================================================================

# --- OpenAI API (Requerido para Voz Realtime, Visión y Razonamiento) ---
OPENAI_API_KEY=

# Modelos OpenAI de frontera VERIFICADOS en tu cuenta (14-nov-2026)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_REALTIME_FALLBACK_MODEL=gpt-realtime
OPENAI_REALTIME_MINI_MODEL=gpt-realtime-2.1-mini

# Voz y cadencia conversacional (velocidad ágil solicitada: 1.18x)
OPENAI_VOICE_NAME=marin
OPENAI_VOICE_FALLBACK=coral
OPENAI_VOICE_SPEED=1.18

# Audio asíncrono (Telegram notas de voz y síntesis dirigida)
OPENAI_STT_MODEL=gpt-live-transcribe
OPENAI_STT_FALLBACK_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15

# Agente multimodal (Facturas, PDFs, Excel, Function Calling) y Auditoría Forense
OPENAI_AGENT_MODEL=gpt-6.1-sol
OPENAI_AGENT_MINI_MODEL=gpt-6.1-terra
OPENAI_REASONING_MODEL=gpt-6.1-sol
OPENAI_FLAGSHIP_MODEL=gpt-6-astra

# --- Supabase Cloud (Opcional en local; recomendado para nube + Realtime) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram Bot Directo (@BotFather, sin Evolution API) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Servidor Web / Seguridad ---
PORT=3080
HOST=127.0.0.1
